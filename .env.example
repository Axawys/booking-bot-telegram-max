# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Токен MAX-бота: business.max.ru → Чат-боты → ⋮ → Настройки.
# Без него сервис max-bot не работает (ждёт настройки), а клиентам MAX не будут уходить
# уведомления о решении админа и напоминания.
MAX_BOT_TOKEN=
# MAX_API_URL=https://platform-api2.max.ru

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot).
# Им приходят новые заявки с кнопками подтверждения и доступны команды /admin.
# Если не задано — записи подтверждаются автоматически.
ADMIN_IDS=

# База данных (по умолчанию SQLite-файл data/bot.db)
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# Шаг сетки расписания в минутах
# SLOT_MINUTES=30
# Расписание
# TIMEZONE=Europe/Moscow
# WORK_START=10:00
# WORK_END=21:00
# BOOKING_HORIZON_DAYS=14
# BOOKING_MIN_LEAD_MINUTES=60

# Антиспам (на админов не действует)
# RATE_LIMIT_MESSAGES=20
# RATE_LIMIT_WINDOW_SECONDS=10
# RATE_LIMIT_COOLDOWN_SECONDS=30
# MAX_ACTIVE_BOOKINGS=3
# MAX_BOOKINGS_PER_DAY=5

# Планировщик
# REMINDER_HOURS=24,2
# REMINDER_GRACE_MINUTES=60
# PENDING_TTL_HOURS=12
# ADMIN_DIGEST_TIME=09:00   # пусто — без утренней сводки
# SCHEDULER_RESYNC_SECONDS=60  # как часто сверять задачи с БД (записи из MAX)
